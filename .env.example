NODE_ENV=development
PORT=8080
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=phaseone:live
PRESENCE_TTL_SECONDS=45
TRACKER_ORIGINS=http://localhost:4321,https://phaseonelabz.com,https://www.phaseonelabz.com,https://staging.phaseonelabz.com
DASHBOARD_ORIGIN=http://localhost:8080
# Public HTTPS origin serving the versioned custom COA API and uploaded PDFs.
COA_PUBLIC_ORIGIN=http://localhost:8080
MONITOR_USERNAME=admin
MONITOR_PASSWORD_HASH='scrypt$32768$8$1$replace-with-salt$replace-with-hash'
SESSION_SECRET=replace-with-at-least-32-random-characters
ANALYTICS_HMAC_SECRET=replace-with-a-stable-32-character-secret
SESSION_TTL_HOURS=12
ANALYTICS_TIME_ZONE=America/Bogota
COOKIE_SECURE=false
TRUST_PROXY=false
# Optional: relay the established hosted visitor stream into a local dashboard.
UPSTREAM_MONITOR_URL=
UPSTREAM_MONITOR_USERNAME=
UPSTREAM_MONITOR_PASSWORD=
# Set all three WooCommerce values to reconcile paid orders server-to-server.
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_ACCESS_MODE=read_only
WOOCOMMERCE_SYNC_INTERVAL_SECONDS=15
WOOCOMMERCE_BACKFILL_DAYS=400
# Optional: Google Search Console OAuth (read-only search performance data).
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://localhost:8080/api/seo/callback
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:phaseonelabz.com
# Optional until Barcode Fulfillment is enabled. Use a dedicated database/schema.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
# Optional until Storage Locations & Barcodes is enabled. Keep this stable after labels are printed.
BARCODE_SIGNING_SECRET=
# Private server-to-server credential shared only with phaseonelabz.com.
AFFILIATE_SERVICE_SECRET=
# Server-only ShipStation API v2 connection. Keep the key out of client code and source control.
SHIPSTATION_API_KEY=
SHIPSTATION_RATE_MODE=live
SHIPSTATION_WAREHOUSE_ID=
# Safety interlock. Keep false until a separately approved real-label pilot.
SHIPSTATION_LABEL_PURCHASE_ENABLED=false
# Independent encrypted Packaging Evidence vault. Keep the secret stable; changing it makes existing photos unreadable.
EVIDENCE_STORAGE_PATH=./data/evidence
EVIDENCE_ENCRYPTION_SECRET=
# Use "outbox" only after the WordPress bridge v1.5+ and its existing SMTP delivery are verified.
# Local development must remain disabled so no customer receives test evidence.
EVIDENCE_NOTIFICATION_MODE=disabled
