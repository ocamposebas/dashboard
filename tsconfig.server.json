{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist/server",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts"]
}
